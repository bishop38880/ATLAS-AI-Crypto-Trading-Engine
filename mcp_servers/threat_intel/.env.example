# ──────────────────────────────────────────────────────────────
# Pre-Execution Threat Intel MCP — Environment Variables
# PROMETHEUS Execution Router — Pre-Execution Security Guardrail
# ──────────────────────────────────────────────────────────────

# Tenderly API Credentials (required)
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=

# Tenderly API Base URL (default: production)
TENDERLY_BASE_URL=https://api.tenderly.co

# GoPlus Security API Base URL (public — no auth required)
GOPLUS_BASE_URL=https://api.gopluslabs.io

# HTTP timeout (seconds) — must resolve in < 500ms for trade latency
HTTP_TIMEOUT_SECONDS=2.0

# Shadow Delta threshold (percentage) — below this triggers HARD_ABORT
# Default 90.0 means >10% hidden tax = abort
SHADOW_DELTA_THRESHOLD_PCT=90.0
