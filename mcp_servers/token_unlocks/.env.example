# ─── Token Unlocks MCP — Required Secrets ────────────────────────────────────
# Copy to .env and fill in your Dune Analytics API key.
# DefiLlama endpoints are free and require no key.

# Dune Analytics free-tier API key (required for Layer 2 vesting queries)
DUNE_API_KEY=your-dune-api-key-here

# ─── Tuning ──────────────────────────────────────────────────────────────────
# Default conviction suppression threshold (% of circulating supply)
# If an impending cliff unlock exceeds this within 72 hours,
# conviction_suppression = True is emitted to veto long positions.
UNLOCK_THRESHOLD_PERCENT=2.0

# Maximum seconds to poll a Dune query before timeout
DUNE_POLL_TIMEOUT_SECONDS=120

# Maximum number of poll attempts before giving up
DUNE_MAX_POLL_ATTEMPTS=20
