# ──────────────────────────────────────────────────────────────
# Prediction Market MCP — Environment Variables
# Section 5 Architecture: Macro Context — Capital-Weighted Probabilities
# ──────────────────────────────────────────────────────────────

# Polymarket (public APIs — no auth required for read-only)
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com

# Kalshi (requires API credentials for authenticated endpoints)
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=

# Rate limiting
POLYMARKET_MAX_REQUESTS_PER_SECOND=5
KALSHI_MAX_REQUESTS_PER_SECOND=3

# Minimum liquidity filter (USD) for search results
DEFAULT_MIN_LIQUIDITY_USD=25000.0

# Request timeout (seconds)
HTTP_TIMEOUT_SECONDS=10.0
