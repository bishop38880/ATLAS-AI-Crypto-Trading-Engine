# Ethereum JSON-RPC (HTTP for tx hydration, WS for newPendingTransactions)
ETH_HTTP_URL=
ETH_WS_URL=

# Optional Flashbots / MEV-Share compatible SSE stream (leave empty to disable)
FLASHBOTS_SSE_URL=

# Solana (HTTP for getTransaction, WS for logsSubscribe)
SOL_HTTP_URL=
SOL_WS_URL=

# Static USD hints when no oracle (Decimal strings)
ETH_USD_HINT=3500
SOL_USD_HINT=150

SURVEILLANCE_ENABLED=true
RECONNECT_DELAY_SECONDS=4.8
MAX_SOL_FETCH_PER_SECOND=12
EVM_FETCH_CONCURRENCY=12
