# Multi-Chain RPC MCP Servers — Required Environment Variables
#
# Phase H3 Architecture — Cross-Chain Contagion Tracking (GoG Super-Layer).
# Copy to .env and fill in production values.

# ── Etherscan API ──────────────────────────────────────────────
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ── Bitcoin Core RPC ───────────────────────────────────────────
BTC_RPC_URL=http://127.0.0.1:8332
BTC_RPC_USER=rpcuser
BTC_RPC_PASS=rpcpassword

# ── Redis (for distributed sliding-window rate limiter) ────────
REDIS_URL=redis://localhost:6379/0

# ── Rate Limits ────────────────────────────────────────────────
# Etherscan free tier: 5 requests/second
ETHERSCAN_RATE_LIMIT=5
# Bitcoin Core RPC: conservative limit to avoid I/O overload
BTC_RPC_RATE_LIMIT=10
