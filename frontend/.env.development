# Loaded for `npm run dev` (mode=development). Same-origin + Vite proxy to ATLAS_* below (defaults: 127.0.0.1:8787).
# Override with frontend/.env.local; use VITE_DEV_ABSOLUTE_API=true only if the UI must call a remote API in dev.
# ATLAS_API_HOST=127.0.0.1
# ATLAS_API_PORT=8787
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_APP_ENV=development
