HELIUS_FLOW_POLL_ENABLED=true
HELIUS_FLOW_POLL_INTERVAL_SECONDS=900
ETHERSCAN_API_KEY=Q96I9RIVDQIVMTSQ2K95IXXZESCTT2ATMV
BRAVE_1_API_KEY=BSAJqNs4nulRE_lKtmgzG45VGPSu4Qg
BRAVE_2_API_KEY=BSAKwDiFb40gqAs-S_PN8uuXn0tLH8w
HYPERTRACKER_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjExMDk0LCJtaWQiOjIyODE1MiwiaWF0IjoxNzc0ODExNjY0fQ.K_eoYFgQ2JpjXjtrktQKngrsCK2S1uAkKYj-b7m72Ag

# ─── Langfuse (optional tracing) ────────────────────────────────────
LANGFUSE_HOST=http://127.0.0.1:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── Bitget / paper trade (read by ATLAS + PROMETHEUS `.env` loader) ─
PAPER_TRADING=true
BITGET_API_KEY=bg_6cba64546b08e02c952994419c961d57
BITGET_API_SECRET=f72af9b07c3e3be35f2a83709e2992b2fe4876f388484e44268896060ee3585e
BITGET_PASSPHRASE=ATLAS8prometheus
BITGET_BASE_URL=https://api.bitget.com

# PROMETHEUS executor (safe defaults)
PAPER_TRADE_EXECUTOR_ENABLED=false
PAPER_TRADE_DRY_RUN=true
BITGET_DEMO_WRITE_ENABLED=false
# DuckDB warehouse for dashboard backtest replay (candles + signals)
ATLAS_BACKTEST_DUCKDB_PATH=prometheus/backtest/polaris_backtest.duckdb

PAPER_TRADE_REDIS_CHANNEL=polaris:paper_trade
PAPER_TRADE_SYMBOL_TTL_SECONDS=3600
PAPER_TRADE_DEFAULT_LEVERAGE=5
BITGET_DEMO_PRODUCT_TYPE=SUSDT-FUTURES
BITGET_DEMO_MARGIN_COIN=SUSDT

# ─── Optional feature flags ─────────────────────────────────────────
ATLAS_RECURSIVE_VERIFY_ENABLED=false
# Nightly RAG memory lifecycle (Escore archival at 02:00 UTC by default)
ATLAS_AGENT_ZERO_JOB_ENABLED=true

# Deterministic confluence-only path (RiskAgent still runs). Skips DeepSeek + reflection overlays.
ATLAS_SIMPLE_PIPELINE_MODE=false

# Horizon outcomes for Decision Journal / MCP feedback (needs ``price_snapshots`` table + ingest)
ATLAS_OUTCOME_HORIZON_JOB_ENABLED=false
ATLAS_OUTCOME_HORIZON_JOB_INTERVAL_SECONDS=900
ATLAS_PRICE_SNAPSHOTS_TABLE=price_snapshots

# Hourly market monitor — daily-8 basket, CoinGecko dual-key + Pyth cross-check
# Requires migration atlas/rag/migrations/008_hourly_market_monitor.sql
ATLAS_HOURLY_MARKET_MONITOR_ENABLED=false
ATLAS_HOURLY_MARKET_MONITOR_INTERVAL_SECONDS=3600

# CoinGecko community fundamentals (cold path; migration 007_asset_community_history.sql)
ATLAS_COMMUNITY_SNAPSHOT_JOB_ENABLED=false
ATLAS_COMMUNITY_SNAPSHOT_JOB_INTERVAL_SECONDS=86400
ATLAS_COMMUNITY_ADMISSION_GATE_ENABLED=false

# ─── Ops watchdog (cron-friendly; see scripts/atlas_backend_watchdog.sh) ─
# ATLAS_WATCHDOG_URL=http://127.0.0.1:8787/api/health
# DISCORD_WEBHOOK_URL=
# ATLAS_WATCHDOG_TIMEOUT_SECONDS=12

# ─── Ad-hoc scripts ─────────────────────────────────────────────────
# chaos_drill.py — refuses to run unless CHAOS_DRILL_ENV=staging
CHAOS_DRILL_ENV=staging
CHAOS_DRILL_DRY_RUN=true
PROMETHEUS_HOST=127.0.0.1

# telegram_alert.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PoR / RWA MCP (Ethereum JSON-RPC)
ETH_RPC_URL=

