# ATLAS / PROMETHEUS — copy to `.env` and fill in secrets locally.
# Never commit `.env`. Frontend uses `frontend/.env.example` (VITE_*).
# MCP servers may use `mcp_servers/*/.env.example` for process-scoped env.

# ─── Core infra (matches docker-compose.dev.yml by default) ─────────
REDIS_URL=redis://127.0.0.1:6379/0
# Fail-fast Redis (avoid ~30s TCP stalls when the server is down).
# REDIS_SOCKET_CONNECT_TIMEOUT_S=2.5
# REDIS_SOCKET_TIMEOUT_S=2.5
# REDIS_STARTUP_PROBE_TIMEOUT_S=3.0
# Background reconnect when falling back to in-memory Redis:
# REDIS_RECONNECT_BACKOFF_INITIAL_S=1.0
# REDIS_RECONNECT_BACKOFF_MAX_S=60.0
# HYDRA: host 6380 → container Redis, DB 1. Set empty to reuse REDIS_URL.
HYDRA_REDIS_URL=redis://127.0.0.1:6380/1
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5433/atlas
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
LANCEDB_URI=data/lancedb

# Full autonomous confluence scoring cycle spacing (seconds). Default 900 (15 minutes).
# ATLAS_CONFLUENCE_CYCLE_INTERVAL_SECONDS=900

# Minimum normalised confluence score (0-100) before execution fan-out (order routing,
# RAG signal-memory writes from the autonomous loop, etc.). Default 68.
# ATLAS_MIN_TRADE_SCORE=68

# ─── JWT (shared with PROMETHEUS dashboard WS) ────────────────────
JWT_SECRET=change-me-for-local-dev
JWT_ALGORITHM=HS256
# PROMETHEUS only: allow ?user_id= on /dashboard/ws/portfolio without JWT.
WS_ALLOW_QUERY_USER_ID=false

# ─── Embeddings ─────────────────────────────────────────────────────
# embed_provider: mistral | lmstudio
# With lmstudio, EMBED_MODEL must match the embedding model id shown in LM Studio.
EMBED_PROVIDER=lmstudio
EMBED_MODEL=mungert/text-embedding-qwen3-embedding-0.6b
MISTRAL_API_KEY=
EMBED_DIMENSIONS=1024
EMBED_BATCH_SIZE=32
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# ─── LLM (DeepSeek is the allowed cloud model per project rules) ───
DEEPSEEK_API_KEY=sk-a82a32560c3a41e3a804a0fdbb9ed579
# LM Studio often accepts any non-empty bearer string locally.
# DEEPSEEK_API_KEY=lm-studio

# OmniBox chat: lmstudio | deepseek
OMNIBOX_CHAT_BACKEND=lmstudio
# When lmstudio: set to the chat model id from LM Studio (e.g. mistralai/mistral-nemo-instruct-2407).
OMNIBOX_CHAT_MODEL=

# Complexity router model ids (OpenAI-compat when using LM Studio)
# For all-local LM Studio: point ROUTER_* at your server and use the same chat model id as OmniBox.
ROUTER_LOCAL_MODEL=deepseek-chat
ROUTER_API_MODEL=deepseek-reasoner
ROUTER_API_ENDPOINT=https://api.deepseek.com/v1/chat/completions

# ─── Coinalyze (four keys — one dedicated endpoint family each) ─────
COINALYZE_KEY_FUNDING=f8249c07-0d06-4e5f-81bc-d3547bb21ff3
COINALYZE_KEY_OI=9d498aec-04e4-4943-8ea0-15b906598579
COINALYZE_KEY_LIQUIDATIONS=b7dcad58-e048-48b3-a06e-61455dd57967
COINALYZE_KEY_LONG_SHORT=b7dcad58-e048-48b3-a06e-61455dd57967

# Override the FastAPI dev listen port (default 8787). Must match `uvicorn --port`
# and the same variable when starting Vite so `/api` and `/ws` proxies stay aligned.
# Vite reads these from the shell or from `frontend/.env.development` (see `loadEnv` in vite.config.ts).
# ATLAS_API_HOST=127.0.0.1
# ATLAS_API_PORT=8787
#
# OpenAPI/Swagger (/docs, /redoc, /openapi.json): disabled by default so the HTTP catalogue is not public.
# ATLAS_EXPOSE_OPENAPI=true

# ─── Tier-2 providers (optional; empty = degraded for that source) ─
FRED_API_KEY=68c3d1e1bf7fdca6e55f1f3ed291e117
NANSEN_API_KEY=rNXGbqSpjn6yPf1hAtuZJ0rrYhbiktk1
NANSEN_MCP_URL=https://mcp.nansen.ai/ra/mcp
DUNE_API_KEY=LQ9T5TpSyfAhnqrny6E7yDd8WixESSZg
DUNE_MCP_URL=http://127.0.0.1:8000
